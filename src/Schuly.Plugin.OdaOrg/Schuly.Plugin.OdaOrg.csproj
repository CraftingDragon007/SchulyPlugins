<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.5.2</Version>
    <Description>OdaOrg integration (ICT-BBAG apprenticeship portal). Scrapes profile, module grades, and ÜK course days into the Schuly backend via HttpClient + AngleSharp.</Description>
    <Authors>schulydev</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Schuly.Plugin.Abstractions" Version="0.3.*" />
  </ItemGroup>

  <!-- Shared provisioning, compiled into the plugin so it stays standalone (no extra dependency DLL). -->
  <ItemGroup>
    <Compile Include="..\Shared\Provisioning\*.cs" />
  </ItemGroup>

</Project>
